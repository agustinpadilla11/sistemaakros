{
  "entities": {
    "Usuario": {
      "title": "Usuario",
      "description": "Usuario del sistema (admin o padre)",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "nombre": { "type": "string" },
        "telefono": { "type": "string" },
        "rol": { "type": "string", "enum": ["admin", "padre"] },
        "creado_en": { "type": "string", "format": "timestamp" }
      },
      "required": ["uid", "email", "nombre", "telefono", "rol", "creado_en"]
    },
    "Alumna": {
      "title": "Alumna",
      "description": "Alumna de gimnasia",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nombre_completo": { "type": "string" },
        "fecha_nacimiento": { "type": "string", "format": "timestamp" },
        "dni": { "type": "string" },
        "foto_dni_url": { "type": "string" },
        "foto_apto_url": { "type": "string" },
        "fecha_apto_medico": { "type": "string", "format": "timestamp" },
        "grupo_id": { "type": "string" },
        "estado": { "type": "string", "enum": ["activa", "inactiva", "pendiente_aprobacion"] },
        "importada": { "type": "boolean" },
        "creado_en": { "type": "string", "format": "timestamp" }
      },
      "required": ["id", "nombre_completo", "fecha_nacimiento", "dni", "estado", "creado_en"]
    },
    "PadreAlumna": {
      "title": "PadreAlumna",
      "description": "Relación entre padre y alumna",
      "type": "object",
      "properties": {
        "usuario_id": { "type": "string" },
        "alumna_id": { "type": "string" },
        "vinculado_en": { "type": "string", "format": "timestamp" }
      },
      "required": ["usuario_id", "alumna_id", "vinculado_en"]
    },
    "Grupo": {
      "title": "Grupo",
      "description": "Grupo de clases",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nombre": { "type": "string" },
        "horario": { "type": "string" },
        "descripcion": { "type": "string" }
      },
      "required": ["id", "nombre", "horario", "descripcion"]
    },
    "Cuota": {
      "title": "Cuota",
      "description": "Cuota mensual de alumna",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "alumna_id": { "type": "string" },
        "mes": { "type": "number" },
        "anio": { "type": "number" },
        "monto": { "type": "number" },
        "estado": { "type": "string", "enum": ["pagado", "pendiente", "vencido"] },
        "fecha_pago": { "type": ["string", "null"], "format": "timestamp" },
        "metodo_pago": { "type": ["string", "null"], "enum": ["efectivo", "transferencia", "otro", null] },
        "notas": { "type": "string" }
      },
      "required": ["id", "alumna_id", "mes", "anio", "monto", "estado"]
    },
    "Producto": {
      "title": "Producto",
      "description": "Producto de merchandising",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nombre": { "type": "string" },
        "descripcion": { "type": "string" },
        "precio": { "type": "number" },
        "stock": { "type": "number" },
        "imagen_url": { "type": "string" }
      },
      "required": ["id", "nombre", "precio", "stock", "imagen_url"]
    },
    "Venta": {
      "title": "Venta",
      "description": "Venta de merchandising",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "alumna_id": { "type": "string" },
        "producto_id": { "type": "string" },
        "cantidad": { "type": "number" },
        "precio_unitario": { "type": "number" },
        "total": { "type": "number" },
        "fecha": { "type": "string", "format": "timestamp" }
      },
      "required": ["id", "alumna_id", "producto_id", "cantidad", "precio_unitario", "total", "fecha"]
    },
    "OtroCosto": {
      "title": "OtroCosto",
      "description": "Costo adicional de alumna",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "alumna_id": { "type": "string" },
        "concepto": { "type": "string" },
        "monto": { "type": "number" },
        "fecha": { "type": "string", "format": "timestamp" },
        "estado": { "type": "string", "enum": ["pagado", "pendiente"] },
        "notas": { "type": "string" }
      },
      "required": ["id", "alumna_id", "concepto", "monto", "fecha", "estado"]
    }
  },
  "firestore": {
    "/usuarios/{usuarioId}": {
      "schema": { "$ref": "#/entities/Usuario" },
      "description": "Usuarios del sistema"
    },
    "/alumnas/{alumnaId}": {
      "schema": { "$ref": "#/entities/Alumna" },
      "description": "Alumnas del gimnasio"
    },
    "/padre_alumna/{docId}": {
      "schema": { "$ref": "#/entities/PadreAlumna" },
      "description": "Relaciones padre-alumna"
    },
    "/grupos/{grupoId}": {
      "schema": { "$ref": "#/entities/Grupo" },
      "description": "Grupos de clase"
    },
    "/cuotas/{cuotaId}": {
      "schema": { "$ref": "#/entities/Cuota" },
      "description": "Cuotas mensuales"
    },
    "/productos/{productoId}": {
      "schema": { "$ref": "#/entities/Producto" },
      "description": "Productos de merchandising"
    },
    "/ventas/{ventaId}": {
      "schema": { "$ref": "#/entities/Venta" },
      "description": "Ventas realizadas"
    },
    "/otros_costos/{costoId}": {
      "schema": { "$ref": "#/entities/OtroCosto" },
      "description": "Costos adicionales"
    }
  }
}
